   "source": [
    "MAX_WORDS = 5000\n",
    "MAX_LEN   = 30\n",
    "\n",
    "# Build LSTM Model\n",
    "lstm_model = Sequential([\n",
    "    # Input: sequence of word IDs → output: sequence of 64-dim word vectors\n",
    "    Embedding(input_dim=MAX_WORDS, output_dim=64, input_length=MAX_LEN,\n",
    "              name='Embedding_Layer'),\n",
    "    \n",
    "    # LSTM reads the sequence and captures context/meaning\n",
    "    LSTM(64, return_sequences=False, name='LSTM_Layer'),\n",
    "    \n",
    "    # Dropout prevents overfitting (40% neurons randomly disabled during training)\n",
    "    Dropout(0.4, name='Dropout'),\n",
    "    \n",
    "    # Fully connected layer for learning complex patterns\n",
    "    Dense(32, activation='relu', name='Dense_FC'),\n",
    "    \n",
    "    # Output: 3 probabilities (one per class), softmax ensures they sum to 1\n",
    "    Dense(3, activation='softmax', name='Output')\n",
    "], name='LSTM_Sentiment_Classifier')\n",
    "\n",
    "lstm_model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='sparse_categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "lstm_model.summary()\n"
   ]
  },
