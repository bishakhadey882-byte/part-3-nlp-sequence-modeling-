      "   0   0   0   0   0  23 126  74 127  29   2   3]\n"
     ]
    }
   ],
   "source": [
    "# Encode target labels: negative=0, neutral=1, positive=2\n",
    "le = LabelEncoder()\n",
    "y = le.fit_transform(df['sentiment_label'])\n",
    "print(\"Label Encoding:\", dict(zip(le.classes_, le.transform(le.classes_))))\n",
    "\n",
    "# Train/Test Split (80/20)\n",
    "X_train_txt, X_test_txt, y_train, y_test = train_test_split(\n",
    "    df['cleaned_text'], y, test_size=0.2, random_state=42, stratify=y)\n",
    "\n",
    "print(f\"\\nTrain set: {len(X_train_txt)} records\")\n",
    "print(f\"Test set : {len(X_test_txt)} records\")\n",
    "\n",
    "# ── Method 1: Bag of Words ──────────────────────────────────\n",
    "bow = CountVectorizer(max_features=5000)\n",
    "X_train_bow = bow.fit_transform(X_train_txt)\n",
    "X_test_bow  = bow.transform(X_test_txt)\n",
    "print(f\"\\nBoW matrix shape: {X_train_bow.shape}\")\n",
    "print(\"  Each row = 1 message, each column = 1 unique word\")\n",
    "print(\"  Value = count of that word in the message\")\n",
    "\n",
    "# ── Method 2: TF-IDF ────────────────────────────────────────\n",
    "tfidf = TfidfVectorizer(max_features=5000, ngram_range=(1,2))\n",
    "X_train_tfidf = tfidf.fit_transform(X_train_txt)\n",
    "X_test_tfidf  = tfidf.transform(X_test_txt)\n",
    "print(f\"\\nTF-IDF matrix shape: {X_train_tfidf.shape}\")\n",
    "print(\"  ngram_range=(1,2) means single words AND word pairs are features\")\n",
    "\n",
    "# ── Method 3: Tokenizer sequences for LSTM ──────────────────\n",
    "MAX_WORDS = 5000\n",
    "MAX_LEN   = 30\n",
    "\n",
    "tokenizer = Tokenizer(num_words=MAX_WORDS, oov_token='<OOV>')\n",
    "tokenizer.fit_on_texts(X_train_txt)\n",
    "\n",
    "X_train_seq = pad_sequences(tokenizer.texts_to_sequences(X_train_txt), maxlen=MAX_LEN)\n",
    "X_test_seq  = pad_sequences(tokenizer.texts_to_sequences(X_test_txt),  maxlen=MAX_LEN)\n",
    "print(f\"\\nTokenized sequence shape: {X_train_seq.shape}\")\n",
    "print(f\"  Each message converted to fixed-length sequence of {MAX_LEN} integers\")\n",
    "print(f\"  Short messages padded with 0s, long ones truncated\")\n",
    "print(f\"\\nExample: '{X_test_txt.iloc[0][:40]}...'\")\n",
    "print(f\"Tokenized: {X_test_seq[0]}\")\n"
   ]
  },
