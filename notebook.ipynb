      "→ Noise removed: ~50% of words were stopwords/punctuation\n"
     ]
    }
   ],
   "source": [
    "def preprocess_text(text):\n",
    "    # Step 1: Lowercase everything\n",
    "    text = text.lower()\n",
    "    \n",
    "    # Step 2: Remove special characters, numbers, punctuation\n",
    "    # Keep only letters and spaces\n",
    "    text = re.sub(r'[^a-z\\s]', '', text)\n",
    "    \n",
    "    # Step 3: Tokenization — split into individual words\n",
    "    tokens = text.split()\n",
    "    \n",
    "    # Step 4: Remove stopwords and very short words (length <= 2)\n",
    "    tokens = [t for t in tokens if t not in STOPWORDS and len(t) > 2]\n",
    "    \n",
    "    # Rejoin into a clean sentence\n",
    "    return ' '.join(tokens)\n",
    "\n",
    "# Apply to entire dataset\n",
    "df['cleaned_text'] = df['customer_message'].apply(preprocess_text)\n",
    "\n",
    "# Show before vs after\n",
    "print(\"PREPROCESSING RESULTS — Before vs After:\")\n",
    "print(\"=\"*65)\n",
    "for i in range(3):\n",
    "    print(f\"\\nExample {i+1}:\")\n",
    "    print(f\"  BEFORE: {df['customer_message'].iloc[i]}\")\n",
    "    print(f\"  AFTER : {df['cleaned_text'].iloc[i]}\")\n",
    "\n",
    "df['clean_word_count'] = df['cleaned_text'].apply(lambda x: len(x.split()))\n",
    "print(f\"\\nAverage words BEFORE cleaning: {df['word_count'].mean():.1f}\")\n",
    "print(f\"Average words AFTER  cleaning: {df['clean_word_count'].mean():.1f}\")\n",
    "print(\"→ Noise removed: ~50% of words were stopwords/punctuation\")\n"
   ]
